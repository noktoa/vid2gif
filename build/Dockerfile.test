# Build context is the repo root. Layers are ordered by how often their inputs
# change, so a code-only change re-runs nothing above the final COPY.
ARG GO_VERSION=1.26

FROM golang:${GO_VERSION} AS tools
WORKDIR /src
# Go modules: re-run only when go.mod or go.sum change.
COPY go.mod go.sum ./
RUN go mod download
# Pinned yt-dlp, ffmpeg and deno (~250 MB): re-run only when deps.json or the
# installer changes. Only the installer's source files are copied (not the
# resolver or the tests), so editing those keeps this layer cached. deps.go
# imports internal/proc, so its sources come along too.
COPY deps.json ./
COPY internal/proc/proc_other.go internal/proc/proc_windows.go internal/proc/
COPY internal/deps/deps.go internal/deps/install.go internal/deps/
COPY build/installtools build/installtools
RUN go run ./build/installtools deps.json /opt/tools

FROM tools AS test
COPY . .
# an absolute path, so it is independent of the default bin/ used outside Docker
ENV VID2GIF_BIN=/opt/tools
CMD ["go", "test", "-tags", "integration", "-v", "-timeout", "30m", "./test/integration/"]
